# LINGUA X / LinguaBridge environment template
# Copy to a local environment manager; never commit real values.
NODE_ENV=development

# Manus OAuth and session authentication
VITE_APP_ID=
OAUTH_SERVER_URL=
JWT_SECRET=
OWNER_OPEN_ID=

# Database
DATABASE_URL=

# Built-in server-side LLM gateway used by the first translation provider
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
TRANSLATION_PROVIDER=manus-llm

# Optional realtime infrastructure
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional WhatsApp integration
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
