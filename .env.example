# LINGUA X / LinguaBridge environment template
# Copy to a local environment manager; never commit real values.
NODE_ENV=development

# Manus OAuth and session authentication
VITE_APP_ID=
APP_ORIGIN=
OAUTH_SERVER_URL=
JWT_SECRET=
OWNER_OPEN_ID=

# Database
DATABASE_URL=

# Built-in server-side LLM gateway used by the registered translation provider
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
# Server-side production STT credential; never expose or commit its value.
DEEPGRAM_API_KEY=
# Comma-separated provider order; only registered providers may be selected.
TRANSLATION_PROVIDER=manus-llm
# Server-side STT provider order; Deepgram is the first production provider.
STT_PROVIDER=deepgram
# Live smoke test only; set real local audio fixture paths when credentials exist.
STT_SMOKE_AUDIO_FILE=
STT_SMOKE_AUDIO_AR=
STT_SMOKE_AUDIO_AR_EG=
STT_SMOKE_AUDIO_ES_ES=
STT_SMOKE_AUDIO_EN_US=
STT_SMOKE_MIME_TYPE=
STT_SMOKE_INCLUDE_TRANSCRIPT=false

# Optional realtime infrastructure
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional WhatsApp integration
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
